# ========================================================
# Novo Hiper — Configurações de Ambiente (Produção / VPS)
# ========================================================
# Copie este arquivo para .env na VPS:
# cp .env.example .env
#
# NUNCA insira credenciais, senhas ou segredos neste arquivo.
# ========================================================

# Ambiente de execução (production ou development)
NODE_ENV=production

# Porta interna do container da aplicação
PORT=3000

# Porta externa mapeada no host da VPS via Docker Compose
# (útil caso a porta 3000 já esteja em uso por outro serviço)
APP_PORT=3000

# Diretório dos dados persistentes do SQLite
DATA_DIR=/app/data

# Caminho completo do arquivo do banco SQLite
DATABASE_PATH=/app/data/novo-hiper.db

# Diretório para armazenamento dos uploads de fotos
UPLOADS_DIR=/app/uploads

# Origens permitidas para requisições CORS
# Exemplo: https://novohiper.seudominio.com.br ou * para liberar todas
CORS_ORIGIN=

# Prefixo da URL da API REST consumida pelo frontend PWA
# Em produção atrás do Nginx, use /api
# Caso o frontend esteja em outro domínio, use https://api.seudominio.com.br/api
VITE_API_URL=/api

# Autenticação (OBRIGATÓRIO em produção — o servidor NÃO sobe sem isto; não existe senha padrão)
AUTH_USERNAME=Bernardo
# Hash scrypt da senha. Gere com:  node scripts/hash-password.mjs   (a senha nunca é gravada em arquivo)
# Formato: scrypt:N:r:p:salt:hash  (sem "$" — seguro para docker compose)
AUTH_PASSWORD_HASH=
# Duração da sessão (cookie HttpOnly), em dias
SESSION_TTL_DAYS=30
# Importação do localStorage (legado): mantenha false/ausente em produção
ENABLE_LEGACY_MIGRATION=false

